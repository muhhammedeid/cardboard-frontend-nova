# Normal UAT / production runtime uses the authenticated Frappe RPC boundary.
# Deterministic fixtures are available only with an explicit VITE_API_MODE=mock
# (see `.env.mock`, used by `npm run dev:mock` and `npm run build:mock`).
VITE_API_MODE=real
# Keep empty for the same-host Vite proxy (dev) and same-origin hosting (prod).
# This value must never contain secrets.
VITE_API_BASE_URL=
