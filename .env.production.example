# Production / UAT runtime contract (same-origin hosting).
# Copy to `.env.production` before `npm run build`.
#
# VITE_API_MODE=real always. A production build refuses `mock` outright (see
# src/app/bootstrap/config.ts), so a demo bundle can never ship by accident.
VITE_API_MODE=real

# Keep empty when the SPA and Frappe share an origin (the documented deployment in
# docs/DEPLOYMENT.md). Set it only when the bundle is hosted elsewhere and the
# backend allows that origin. This value must never contain secrets.
VITE_API_BASE_URL=
